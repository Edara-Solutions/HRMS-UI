{
  "name": "hrms-front-end",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty",
    "lint": "bun run lint:biome && bun run lint:architecture",
    "lint:biome": "biome check .",
    "lint:architecture": "steiger src",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "openapi:types": "openapi-typescript http://localhost:3000/api/v1/openapi.json -o src/api/schema.d.ts",
    "doctor": "react-doctor ."
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-router": "^1.100.0",
    "apexcharts": "^4.4.0",
    "clsx": "^2.1.1",
    "i18next": "^24.2.0",
    "i18next-http-backend": "^3.0.0",
    "ky": "^1.7.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-apexcharts": "^1.7.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-i18next": "^15.4.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/router-plugin": "^1.100.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.6.0",
    "react-doctor": "^0.5.8",
    "steiger": "^0.5.13",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vitest": "^3.2.6"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild",
    "msgpackr-extract"
  ]
}
