VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_OPENAPI_SCHEMA_URL=http://localhost:3000/api/v1/openapi.json

# Build-time seam: set to "true" to include the platform-operator console
# (/admin/* routes) in the build. Leave unset/false for tenant-only builds.
VITE_ENABLE_ADMIN=true

# Lead status edits normally follow the backend transition table.
# Set to "true" to let admins choose any editable status.
ALLOW_LEAD_STATUS_OVERRIDE=false

# Lead conversion normally requires a sales-ready status.
# Set to "true" to show Convert for any non-converted lead state.
ALLOW_CONVERT_LEAD_TO_COMPANY_FROM_ANY_STATE=false

# Date range filters default to inclusive edges. Set to "true" to let users
# choose inclusive/exclusive edges in date and date-time pickers.
VITE_ALLOW_EDGE_DATE_CHOISE=false
ALLOW_EDGE_DATE_CHOISE=false
